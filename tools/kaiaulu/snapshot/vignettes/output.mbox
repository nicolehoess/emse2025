 %ifstr %1
+    ; 1<<(%1-1) / W4 < 1
 %else
     paddw       m10, [%1]
 %endif
@@ -87,6 +88,17 @@ cextern w7_min_w5
     pmaddwd     m7,  m1, [w4_min_w2]
