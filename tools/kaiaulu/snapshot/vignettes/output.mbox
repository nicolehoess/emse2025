 libavformat/avformat.h    | 16 +++++++++++++++
 libavformat/matroskaenc.c | 22 ++++++++++++++++++++-
 libavformat/mux.c         | 25 +++++++++++++++++++++++-
 libavformat/utils.c       | 50 +++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 115 insertions(+), 43 deletions(-)

