     STEREO_CODE_COUNT   // TODO: needs autodetection
 };
 
@@ -189,6 +192,8 @@ static const AVOption stereo3d_options[] = {
     { "sbs2r", "side by side half width right first", 0, AV_OPT_TYPE_CONST, {.i64=SIDE_BY_SIDE_2_RL},  0, 0, FLAGS, "out" },
