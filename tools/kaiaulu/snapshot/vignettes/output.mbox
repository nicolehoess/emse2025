> >>> +    if (a >= 9223372036854775808.0)
> >>> +        return INT64_MAX;
> >>> +    if (a <= INT64_MIN)
> >>> +        return INT64_MIN;
> >>> +    // Finally safe to call av_clipd_c
> >>> +    return (int64_t)av_clipd_c(a, amin, amax);
