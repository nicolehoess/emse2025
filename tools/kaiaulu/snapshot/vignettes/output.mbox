+    ERROR_IF ((e_opt)->name == 1 && (p_opt)->name == OPT_BANNED, \
+              "Profile %i does not allow %s\n", avctx->profile, #name); \
+    ERROR_IF ((e_opt)->name == 0 && (p_opt)->name == OPT_REQUIRED, \
