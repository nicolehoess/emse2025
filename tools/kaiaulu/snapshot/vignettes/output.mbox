+{
+    return mlp_thd_probe(p, 0xf8726fba);
+}
+
 AVInputFormat ff_truehd_demuxer = {
     .name           = "truehd",
     .long_name      = NULL_IF_CONFIG_SMALL("raw TrueHD"),
+    .read_probe     = thd_probe,
     .read_header    = ff_raw_audio_read_header,
