             n = pkt->size;
             i = 2;
@@ -1535,9 +1560,21 @@ static int mpegts_write_packet_internal(AVFormatContext *s, AVPacket *pkt)
 
             av_assert0(2 + pkt->size / 255 + 1 == i);
 
