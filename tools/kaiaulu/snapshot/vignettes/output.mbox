+.loop:
+    mova              m0, [src2q + iq]
+    mova              m1, [src1q + iq]
+    psubb             m1, m0
+    mova     [iq + dstq], m1
+    mova              m0, [src2q + iq + 8]
+    mova              m1, [src1q + iq + 8]
+    psubb             m1, m0
+    mova [8 + iq + dstq], m1
+    add               iq, 16
+    cmp               iq, wq
+        jb         .loop
+    add               wq, 15
+.loop2:
+    mov              r6b, byte [src1q + iq]
+    sub              r6b, byte [src2q + iq]
+    mov byte [dstq + iq], r6b
+    inc               iq
+    cmp               iq, wq
+        jb        .loop2
+    REP_RET
