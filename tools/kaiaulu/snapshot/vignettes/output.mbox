             if (sub->rects) {
                 sub->num_rects = 1;
                 sub->rects[0] = ctx->pages->sub_rect;
-            } else {
-                ret = AVERROR(ENOMEM);
-            }
-
 #if FF_API_AVPICTURE
 FF_DISABLE_DEPRECATION_WARNINGS
-            for (j = 0; j < 4; j++) {
-                sub->rects[0]->pict.data[j] = sub->rects[0]->data[j];
-                sub->rects[0]->pict.linesize[j] = sub->rects[0]->linesize[j];
