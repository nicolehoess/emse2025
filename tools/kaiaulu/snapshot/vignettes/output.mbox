diff --git a/tests/fate-run.sh b/tests/fate-run.sh
index a3938dc..612d9a2 100755
--- a/tests/fate-run.sh
+++ b/tests/fate-run.sh
@@ -249,6 +249,26 @@ gapless(){
     do_md5sum $decfile3
 }
 
+concat(){
+    template=tests/$1
+    sample=$(target_path $2)
+    mode=$3
+    extra_args=$4
+
+    concatfile="${outdir}/${test}.ffconcat"
+    packetfile="${outdir}/${test}.ffprobe"
+    cleanfiles="$concatfile $packetfile"
+
+    awk "{gsub(/%SRCFILE%/, \"$sample\"); print}" $template > $concatfile
+
+    if [ "$mode" = "md5" ]; then
+      run ffprobe${PROGSUF} -show_streams -show_packets -v 0 -fflags keepside -safe 0 $extra_args $concatfile > $packetfile
+      do_md5sum $packetfile
+    else
+      run ffprobe${PROGSUF} -show_streams -show_packets -v 0 -fflags keepside -safe 0 $extra_args $concatfile
+    fi
+}
+
 mkdir -p "$outdir"
 
