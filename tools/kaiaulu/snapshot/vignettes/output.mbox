             y_in = (y_out + 1) + (j * 2) - n_coef_lf[filter];
@@ -202,18 +283,12 @@ static int deinterlace_slice(AVFilterContext *ctx, void *arg, int jobnr, int nb_
         work_line = s->work_line[jobnr];
         switch (n_coef_lf[filter]) {
