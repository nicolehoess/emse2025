             c->idct_put  = ff_simple_idct10_put_sse2;
             c->idct_add  = NULL;
@@ -106,9 +106,7 @@ av_cold void ff_idctdsp_init_x86(IDCTDSPContext *c, AVCodecContext *avctx,
         }
         }
 
-        if (avctx->bits_per_raw_sample == 12 &&
-            (avctx->idct_algo == FF_IDCT_AUTO ||
