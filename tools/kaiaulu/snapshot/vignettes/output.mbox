 #include "avformat.h"
 #include "internal.h"
@@ -431,6 +432,21 @@ retry:
                 return ret;
             }
             str[str_size] = 0;
+            if (!strcmp(key, "com.apple.quicktime.creationdate")) {
+                struct tm *ptm, tmbuf;
+                int64_t timeval;
+                if (av_parse_time(&timeval, str, 0) >= 0) {
+                    time_t timet = timeval / 1000000;
