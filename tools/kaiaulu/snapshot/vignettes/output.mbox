> +++ b/libavcodec/xface.c
> @@ -315,7 +315,7 @@ void ff_xface_generate_face(uint8_t *dst, uint8_t * const src)
>
>              for (l = i - 2; l <= i + 2; l++) {
>                  for (m = j - 2; m <= j; m++) {
> -                    if (l >= i && m == j)
> +                    if ((l - i >= 0) && m == j)
>                          continue;
>                      if (l > 0 && l <= XFACE_WIDTH && m > 0)
