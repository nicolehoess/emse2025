+++ b/libavcodec/x86/vp9dsp_init_16bpp.c
@@ -31,14 +31,22 @@
 
 #if HAVE_YASM
 
-decl_fpel_func(put,   8, mmx);
-decl_fpel_func(put,  16, sse);
