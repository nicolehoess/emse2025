--- a/libavcodec/aacsbr_fixed_tablegen.h
+++ b/libavcodec/aacsbr_fixed_tablegen.h
@@ -25,8 +25,4 @@
 
 #include "aacsbr_tablegen_common.h"
 
-#if CONFIG_HARDCODED_TABLES
