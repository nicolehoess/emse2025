+        movu                 m0, [lsrcq+o+0]
+        pshufb              m10, m0, [ex_r]
+        pshufb               m2, m0, [ex_g]
+        pshufb               m3, m0, [ex_b]
+        movu                 m0, [rsrcq+o+0]
+        pshufb               m4, m0, [ex_r]
+        pshufb               m5, m0, [ex_g]
+        pshufb               m6, m0, [ex_b]
+        pmulld              m10, [rsp+mmsize*6]
+        pmulld               m2, [rsp+mmsize*7]
+        pmulld               m3, [rsp+mmsize*8]
+        pmulld               m4, [rsp+mmsize*9]
+        pmulld               m5, [rsp+mmsize*10]
+        pmulld               m6, [rsp+mmsize*11]
+        paddd               m10, m2
+        paddd               m10, m3
+        paddd               m10, m4
+        paddd               m10, m5
+        paddd               m10, m6
+        psrld               m10, 16
+
+        movu                 m0, [lsrcq+o+0]
+        pshufb               m11, m0, [ex_r]
+        pshufb               m2, m0, [ex_g]
+        pshufb               m3, m0, [ex_b]
+        movu                 m0, [rsrcq+o+0]
+        pshufb               m4, m0, [ex_r]
+        pshufb               m5, m0, [ex_g]
+        pshufb               m6, m0, [ex_b]
+        pmulld               m11, [rsp+mmsize*12]
+        pmulld               m2, [rsp+mmsize*13]
+        pmulld               m3, [rsp+mmsize*14]
+        pmulld               m4, [rsp+mmsize*15]
+        pmulld               m5, [rsp+mmsize*16]
+        pmulld               m6, [rsp+mmsize*17]
+        paddd                m11, m2
+        paddd                m11, m3
+        paddd                m11, m4
+        paddd                m11, m5
+        paddd                m11, m6
+        psrld                m11, 16
+
+        packusdw              m1, m10
+        packusdw             m11, m12
+        packuswb              m1, m11
+        pshufb                m1, [shuf]
+
+        movq         [dstq+o+0], m1
+        psrldq               m1, 8
+        movd         [dstq+o+8], m1
+        add                r12d, 12
+        sub                r11d, 4
+    jg .loop
