+    paddd       m5, [pd_round]
+    paddd       m6, [pd_round]
+    paddd       m7, [pd_round]
+    paddd       m0, [pd_round]
+    paddd       m1, [pd_round]
+%endif
 
     ; a0: -1*row[0]-1*row[2]
