> >> @@ -40,7 +40,7 @@ typedef enum {
> >>      AV_CRC_32_IEEE,
> >>      AV_CRC_32_IEEE_LE,  /*< reversed bitorder version of AV_CRC_32_IEEE */
> >>      AV_CRC_16_ANSI_LE,  /*< reversed bitorder version of AV_CRC_16_ANSI */
