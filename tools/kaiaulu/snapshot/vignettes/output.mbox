+//Missing level aren't supported by VideoToolbox.
+static const VTEncValuePair vtenc_h264_level_pairs[] = {
+    { "auto", kLevel_Auto },
+    { "1.3" , kLevel_1_3 },
+    { "3"   , kLevel_3_0 },
+    { "3.0" , kLevel_3_0 },
+    { "3.1" , kLevel_3_1 },
+    { "3.2" , kLevel_3_2 },
+    { "4"   , kLevel_4_0 },
