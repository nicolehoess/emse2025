+    SBUTTERFLY                      wd, 4, 5, 7
+    pmaddwd                         m4, m0
+    pmaddwd                         m5, m1
+    movh                            m6, [in_lines_cur2q+r4q]
+    movh                            m8, [in_lines_cur3q+r4q]
+    pxor                            m7, m7
+    punpcklbw                       m6, m7
+    punpcklbw                       m8, m7
+    SBUTTERFLY                      wd, 6, 8, 7
+    pmaddwd                         m6, m2
+    pmaddwd                         m8, m3
+    paddd                           m4, m6
+    paddd                           m5, m8
+    mova            [work_lineq+r4q*4], m4
+    mova     [work_lineq+r4q*4+mmsize], m5
+    add                            r4q, 8
+    sub                      linesized, 8
+    jg .loop
+REP_RET
+
+cglobal w3fdif_complex_high, 5, 14, 10, 0, work_line, in_lines_cur0, in_lines_adj0, coef, linesize
+    movq                  m3, [coefq+0]
+    movd                  m4, [coefq+8]
+    SPLATW                m0, m3, 0
+    SPLATW                m1, m3, 1
+    SPLATW                m2, m3, 2
+    SPLATW                m3, m3, 3
+    SPLATW                m4, m4
+    SBUTTERFLY            wd, 0, 1, 7
+    SBUTTERFLY            wd, 2, 3, 7
+    mov                  r5q, 0
+    mov                  r9q, [in_lines_cur0q+gprsize*4]
+    mov                  r8q, [in_lines_cur0q+gprsize*3]
+    mov                  r7q, [in_lines_cur0q+gprsize*2]
+    mov                  r6q, [in_lines_cur0q+gprsize]
+    mov       in_lines_cur0q, [in_lines_cur0q]
+    %define   in_lines_cur1q  r6q
+    %define   in_lines_cur2q  r7q
+    %define   in_lines_cur3q  r8q
+    %define   in_lines_cur4q  r9q
+    mov                 r13q, [in_lines_adj0q+gprsize*4]
+    mov                 r12q, [in_lines_adj0q+gprsize*3]
+    mov                 r11q, [in_lines_adj0q+gprsize*2]
+    mov                 r10q, [in_lines_adj0q+gprsize]
+    mov       in_lines_adj0q, [in_lines_adj0q]
+    %define   in_lines_adj1q  r10q
+    %define   in_lines_adj2q  r11q
+    %define   in_lines_adj3q  r12q
+    %define   in_lines_adj4q  r13q
+
+    .loop
+    movh                            m5, [in_lines_cur0q+r5q]
+    movh                            m6, [in_lines_cur1q+r5q]
+    pxor                            m7, m7
+    punpcklbw                       m5, m7
+    punpcklbw                       m6, m7
+    SBUTTERFLY                      wd, 5, 6, 7
+    pmaddwd                         m5, m0
+    pmaddwd                         m6, m1
+    movh                            m8, [in_lines_cur2q+r5q]
+    movh                            m9, [in_lines_cur3q+r5q]
+    pxor                            m7, m7
+    punpcklbw                       m8, m7
+    punpcklbw                       m9, m7
+    SBUTTERFLY                      wd, 8, 9, 7
+    pmaddwd                         m8, m2
+    pmaddwd                         m9, m3
+    paddd                           m5, m8
+    paddd                           m6, m9
+    movh                            m8, [in_lines_adj0q+r5q]
+    movh                            m9, [in_lines_adj1q+r5q]
+    pxor                            m7, m7
+    punpcklbw                       m8, m7
+    punpcklbw                       m9, m7
+    SBUTTERFLY                      wd, 8, 9, 7
+    pmaddwd                         m8, m0
+    pmaddwd                         m9, m1
+    paddd                           m5, m8
+    paddd                           m6, m9
+    movh                            m8, [in_lines_adj2q+r5q]
+    movh                            m9, [in_lines_adj3q+r5q]
+    pxor                            m7, m7
+    punpcklbw                       m8, m7
+    punpcklbw                       m9, m7
+    SBUTTERFLY                      wd, 8, 9, 7
+    pmaddwd                         m8, m2
+    pmaddwd                         m9, m3
+    paddd                           m5, m8
+    paddd                           m6, m9
+    movh                            m8, [in_lines_cur4q+r5q]
