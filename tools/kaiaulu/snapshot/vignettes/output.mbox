---
Changes v1 -> v2:
 - Nothing.

 configure |    5 +++--
 1 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/configure b/configure
index 83b2a64..ea129be 100755
--- a/configure
+++ b/configure
@@ -4094,8 +4094,9 @@ elif enabled mips; then
             disable mips64r6
             disable mipsdsp
             disable mipsdspr2
-
-            check_cflags "-mtune=p5600"
