 libavcodec/dnxhddata.h |   3 +
 libavcodec/dnxhddec.c  | 146 +++++++++++++++++++++++++++++++++----------------
 libavformat/isom.c     |   1 +
 4 files changed, 169 insertions(+), 70 deletions(-)

