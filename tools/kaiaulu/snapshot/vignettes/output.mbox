+%include "libavutil/x86/x86util.asm"
+
+SECTION .text
+
+INIT_XMM sse2
+cglobal w3fdif_scale, 3, 3, 2, 0, out_pixel, work_pixel, linesize
+.loop
+    mova                         m0, [work_pixelq]
+    mova                         m1, [work_pixelq+mmsize]
+    psrad                        m0, 15
+    psrad                        m1, 15
+    packssdw                     m0, m1
