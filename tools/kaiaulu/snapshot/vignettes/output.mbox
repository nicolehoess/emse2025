+            iv[0][j] = iv[1][j] = rnd() & 0xFF;
+        call_ref(&enc, temp[0], pt, 2, iv[0]);
+        call_new(&enc, temp[1], pt, 2, iv[1]);
+        for (j = 0; j < 16; j++) {
+            if (temp[0][j] != temp[1][j]) {
+                fail();
+            }
+        }
+        bench_new(&enc, temp[1], pt, 1, NULL);
+    }
+    report("encrypt");
+}
