 AVInputFormat ff_mlp_demuxer = {
     .name           = "mlp",
@@ -242,9 +249,15 @@ AVInputFormat ff_mlp_demuxer = {
 #endif
 
 #if CONFIG_TRUEHD_DEMUXER
