> +    }
> +
> +    /* Main packet decoding loop */
> +    av_log(d, AV_LOG_TRACE, "main packet decoding loop\n");
> +    for (;;) {
> +        ret = av_thread_message_queue_recv(d->pkt_queue, &pkt, 0);
> +        if (ret < 0)
> +            break;
> +
> +        orig_pkt = pkt;
> +        do {
> +            ret = decode_packet(d, &pkt, &dec_frame, &got_frame);
