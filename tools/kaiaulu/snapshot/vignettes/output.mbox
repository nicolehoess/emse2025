---
 libavfilter/vf_w3fdif.c          | 127 +++++++++++++-----
 libavfilter/w3fdif.h             |  47 +++++++
 libavfilter/x86/Makefile         |   2 +
 libavfilter/x86/vf_w3fdif.asm    | 270 +++++++++++++++++++++++++++++++++++++++
