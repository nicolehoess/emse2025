From christophe.gisquet@gmail.com  Thu Oct  1 22:01:27 2015  Thu Oct  1 22:01:27 2015
From: christophe.gisquet@gmail.com (Christophe Gisquet) (Christophe Gisquet)
Date: Thu,  1 Oct 2015 22:01:27 +0200
Subject: [FFmpeg-devel] [PATCH 3/3] dnxhddec: init scantable once
	permutation is set
In-Reply-To: <1443729687-3628-1-git-send-email-christophe.gisquet@gmail.com>
References: <1443729687-3628-1-git-send-email-christophe.gisquet@gmail.com>
Message-ID: <1443729687-3628-4-git-send-email-christophe.gisquet@gmail.com>

Otherwise, the dsp may change without its permuation being applied.
---
 libavcodec/dnxhddec.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libavcodec/dnxhddec.c b/libavcodec/dnxhddec.c
index 8d9b7f0..18b2d51 100644
--- a/libavcodec/dnxhddec.c
+++ b/libavcodec/dnxhddec.c
@@ -127,8 +127,6 @@ static int dnxhd_init_vlc(DNXHDContext *ctx, uint32_t cid)
                  ctx->cid_table->run_bits, 1, 1,
                  ctx->cid_table->run_codes, 2, 2, 0);
 
-        ff_init_scantable(ctx->idsp.idct_permutation, &ctx->scantable,
-                          ff_zigzag_direct);
         ctx->cid = cid;
     }
     return 0;
@@ -211,6 +209,8 @@ static int dnxhd_decode_header(DNXHDContext *ctx, AVFrame *frame,
     if (ctx->bit_depth != old_bit_depth) {
         ff_blockdsp_init(&ctx->bdsp, ctx->avctx);
         ff_idctdsp_init(&ctx->idsp, ctx->avctx);
+        ff_init_scantable(ctx->idsp.idct_permutation, &ctx->scantable,
+                          ff_zigzag_direct);
     }
 
     cid = AV_RB32(buf + 0x28);
-- 
