@@ -710,6 +710,9 @@ static void enqueue_packet(RTPDemuxContext *s, uint8_t *buf, int len)
     packet->next     = *cur;
     *cur = packet;
     s->queue_len++;
+    if (s->queue_len >= s->queue_size)
+        av_log(s->st ? s->st->codec : NULL, AV_LOG_ERROR,
+                "jitter buffer full\n");
 }
 
