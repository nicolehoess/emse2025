---
 libavcodec/lpc.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libavcodec/lpc.h b/libavcodec/lpc.h
index 7e0ee3e..edb1a6b 100644
--- a/libavcodec/lpc.h
+++ b/libavcodec/lpc.h
@@ -116,12 +116,12 @@ void ff_lpc_init_x86(LPCContext *s);
