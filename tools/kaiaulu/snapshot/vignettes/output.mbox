+#define have_mips32r5(flags)    CPUEXT(flags, MIPS32R5)
+#define have_mips64r6(flags)    CPUEXT(flags, MIPS64R6)
+#define have_mipsdspr1(flags)   CPUEXT(flags, MIPSDSPR1)
+#define have_mipsdspr2(flags)   CPUEXT(flags, MIPSDSPR2)
