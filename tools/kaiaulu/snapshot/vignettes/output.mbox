+        }
+
+        /* 8 is to convert to bits, 1000000 is 1 second in microseconds (usec) */
+        while ((s->total_packet_size * 8 * 1000000) > ((int64_t)s->cbr * (av_gettime() - s->time_start))) {
+            av_usleep(10);
