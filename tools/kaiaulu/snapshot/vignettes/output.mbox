+    BLEND_VIVIDLIGHT,
+    BLEND_XOR,
+    BLEND_HARDMIX,
+    BLEND_LINEARLIGHT,
+    BLEND_GLOW,
+    BLEND_ADDITION128,
+    BLEND_NB
+};
+
+typedef struct FilterParams {
+    enum BlendMode mode;
+    double opacity;
+    AVExpr *e;
+    char *expr_str;
+    void (*blend)(const uint8_t *top, ptrdiff_t top_linesize,
